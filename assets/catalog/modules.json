 "utgaar": {
  "_om": "Det som ikke dømmes lenger (eieren 19. oktober: «Det er 394 deler til godkjenning fortsatt. De fleste løse.»): bitene i de gamle kryptnivåene (`crypt_NN_*`, også de falske veggene) erstattes av nivåene bygd av moduler (docs/plan.md del 15, docs/nivaaredigering.md del 18 og 21), og byggesettets reservevegg brukes ikke der (den falske veggen er temaets egen, `grav_falsk`). De står i en sammenfoldet liste nederst på godkjenningssiden; dommene eieren alt har gitt, står.",
  "hvorfor": "Erstattes av nivåene bygd av moduler",
  "moenster": [
   "^crypt_\\d\\d_"
  ],
  "navn": [
   "kit_secret_wall"
  ]
 },
