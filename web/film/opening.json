 "texts": [
  {
   "t": [
    1.5,
    10.5
   ],
   "heading": "Fristad",
   "x": "7vw",
   "y": "14vh",
   "size": "xl"
  },
  {
   "t": [
    20.5,
    27.5
   ],
   "text": "I de gode årene skrev de komponentene i Skriptoriet. Hver av dem gjorde én ting, og gjorde den vel.",
   "x": "6vw",
   "y": "56vh",
   "w": "46vw"
  },
  {
   "t": [
    30,
    37
   ],
   "text": "Så sivet forretningslogikken inn. Knappene gjorde ting ingen hadde bedt om, og skjemaene sa nei til alt.",
   "x": "48vw",
   "y": "14vh",
   "w": "44vw",
   "align": "right"
  },
  {
   "t": [
    42.5,
    48
   ],
   "text": "Om natta bar de dem ut av byen.",
   "x": "52vw",
   "y": "60vh",
   "w": "40vw",
   "align": "right"
  },
  {
   "t": [
    54.5,
    61
   ],
   "text": "De korrupte komponentene ble båret ned under kirka og murt inne. Klokka ringte i tre dager.",
   "x": "6vw",
   "y": "16vh",
   "w": "46vw"
  },
  {
   "t": [
    64,
    71
   ],
   "text": "Men det som er murt inne, ligger ikke stille. Der nede går de ennå.",
   "x": "26vw",
   "y": "62vh",
   "w": "48vw",
   "align": "center"
  },
  {
   "t": [
    77,
    84
   ],
   "heading": "Anno 1350",
   "x": "7vw",
   "y": "12vh",
   "size": "xl"
  },
  {
   "t": [
    79,
    87
   ],
   "text": "På torget hvisker de om gull og glemte bøker under kirkegården, og om dem som gikk ned og aldri kom opp igjen.",
   "x": "48vw",
   "y": "56vh",
   "w": "44vw",
   "align": "right"
  },
  {
   "t": [
    96,
    104
   ],
   "text": "Og en dag kommer en fremmed gjennom sørporten.",
   "x": "7vw",
   "y": "18vh",
   "w": "54vw"
  }
 ],
