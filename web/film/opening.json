    [
     "text",
     "Riket var fullt av byer, og hver by hadde sitt skriptorium og sitt eget tungemål."
    ],
    [
     "quote",
     "Men alle delte én mønsterbok."
    ]
   ],
   "h": 2.184,
   "width": 32.094,
   "align": "center",
