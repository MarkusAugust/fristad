   ],
   "lines": [
    [
     "text",
     "Mønsterbøkene ble brent, og hver komponent ble spent fast i rammeverket, med Kontorets regler stemplet på."
    ]
   ],
   "h": 1.092,
   "width": 14.235,
   "align": "left",
