   "at": [
    53.129,
    5.751,
    -64
   ],
   "lines": [
    [
     "text",
     "Hver by bygde av den akkurat det den trengte, og boka sto aldri i veien."
    ]
   ],
   "h": 1.092,
   "width": 14.235,
   "align": "left",
   "pace": 0.12
  },
  {
   "t": [
