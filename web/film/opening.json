   "at": [
    53.647,
    5.241,
    -64
   ],
   "lines": [
    [
     "text",
     "I Fristad var det"
    ],
    [
     "heading",
     "mester Ansgar"
    ],
    [
     "text",
     "som holdt den."
    ]
   ],
   "h": 1.456,
   "width": 12.941,
   "align": "left",
   "pace": 0.12
  },
  {
   "t": [
    39.1,
    43.5
   ],
   "at": [
    150.397,
    5.751,
    -64
   ],
   "lines": [
    [
     "text",
     "I hovedstaden satt et råd som aldri hadde holdt en fjærpenn,"
    ],
    [
     "text",
     "og ved siden av dem kjøpmennene fra Kontoret med sine regler."
    ]
   ],
   "h": 1.092,
   "width": 23.294,
   "align": "center",
   "pace": 0.12
  },
  {
   "t": [
    43.8,
    48.7
   ],
   "at": [
    150.397,
    5.416,
    -64
   ],
   "lines": [
    [
     "quote",
     "De mente at alle byer burde ha det likt,"
    ],
    [
     "quote",
     "og at de visste best hvordan."
    ]
   ],
   "h": 1.165,
   "width": 23.294,
   "align": "center",
   "pace": 0.12
  },
  {
   "t": [
    52.5,
    61.6
   ],
   "at": [
    226.7,
    5.649,
    -64
   ],
   "lines": [
    [
     "text",
     "Så kom kongens bud, på kanselliets latin:"
    ],
    [
     "quote",
     "Omnia lingua Reactia."
    ],
    [
     "text",
     "Alt på hoffets tunge."
    ],
    [
     "quote",
     "Omnia una compage."
    ],
    [
     "text",
     "Alt med ett rammeverk."
    ],
    [
     "quote",
     "Nulla exceptio."
    ],
    [
     "text",
     "Ingen avvik."
    ]
   ],
   "h": 1.019,
   "width": 12.941,
   "align": "left",
   "pace": 0.12
  },
  {
   "t": [
