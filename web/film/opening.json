   ],
   "lines": [
    [
     "heading",
     "Inkvisisjonen"
    ],
    [
     "text",
     "dro fra by til by."
    ]
   ],
   "h": 1.601,
   "width": 15.529,
   "align": "left",
   "pace": 0.12
  },
  {
